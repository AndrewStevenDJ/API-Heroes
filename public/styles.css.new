@keyframes bar-animation {
  0% { background-position: 0 0; }
  100% { background-position: 20px 0; }
}

/* Estilos específicos para cada tipo de barra basados en sus valores */
.bar-fill[data-type="salud"] {
  background: linear-gradient(45deg, 
    rgba(255, 59, 48, 0.9), 
    rgba(255, 90, 78, 0.8)
  );
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.2) 25%,
    transparent 25%,
    transparent 50%,
    rgba(255, 255, 255, 0.2) 50%,
    rgba(255, 255, 255, 0.2) 75%,
    transparent 75%,
    transparent
  );
}

.bar-fill[data-type="energia"] {
  background: linear-gradient(45deg, 
    rgba(52, 199, 89, 0.9), 
    rgba(90, 220, 120, 0.8)
  );
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.2) 25%,
    transparent 25%,
    transparent 50%,
    rgba(255, 255, 255, 0.2) 50%,
    rgba(255, 255, 255, 0.2) 75%,
    transparent 75%,
    transparent
  );
}

.bar-fill[data-type="felicidad"] {
  background: linear-gradient(45deg, 
    rgba(0, 122, 255, 0.9), 
    rgba(64, 156, 255, 0.8)
  );
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.2) 25%,
    transparent 25%,
    transparent 50%,
    rgba(255, 255, 255, 0.2) 50%,
    rgba(255, 255, 255, 0.2) 75%,
    transparent 75%,
    transparent
  );
}

/* Cambia el color dependiendo del valor */
.bar-fill[data-value="low"] {
  background: linear-gradient(45deg, 
    rgba(255, 59, 48, 0.9), 
    rgba(255, 90, 78, 0.8)
  );
  animation: bar-pulse 1.5s infinite alternate;
}

.bar-fill[data-value="medium"] {
  background: linear-gradient(45deg, 
    rgba(255, 204, 0, 0.9), 
    rgba(255, 214, 30, 0.8)
  );
}

.bar-fill[data-value="high"] {
  background: linear-gradient(45deg, 
    rgba(52, 199, 89, 0.9), 
    rgba(90, 220, 120, 0.8)
  );
}

@keyframes bar-pulse {
  0% { opacity: 0.7; }
  100% { opacity: 1; }
}

/* Iconos para las barras de estado */
.status-bar .icon {
  font-size: 1.6em;
  filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.15));
  margin-right: 6px;
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
              filter 0.3s ease;
}

.status-bar:hover .icon {
  transform: scale(1.3) rotate(5deg);
  filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.2));
}

/* Efecto adicional al pasar el mouse */
.status-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(120deg, 
    rgba(255, 255, 255, 0) 0%, 
    rgba(255, 255, 255, 0.3) 50%, 
    rgba(255, 255, 255, 0) 100%);
  transform: translateX(-100%);
  transition: transform 0.6s;
}

.status-bar:hover::after {
  transform: translateX(100%);
}

@media (max-width: 600px) {
  #pet-img { width: 120px; height: 120px; }
  #status-bars { bottom: 90px; }
  #actions { bottom: 20px; }
  .status-bar { min-width: 60px; font-size: 0.9em; }
  #register-form, #login-form {
    min-width: 90vw;
    padding: 18px 6vw 12px 6vw;
  }
  #pet-svg-container { width: 120px; height: 120px; }
  #select-pet-btn, .exit-btn { padding: 12px 18vw; font-size: 1em; }
}
